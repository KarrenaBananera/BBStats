@page "/AllTimeCharacters/{character?}"
@model BBStats.Pages.AllTimeCharacters.IndexModel
@{
    var pageSuffix = Model.Top.PageNumber > 1 ? $" — Page {Model.Top.PageNumber}" : "";
    ViewData["Title"] = $"All-Time {Model.CharacterDisplayName} Elo — BlazBlue Centralfiction{pageSuffix}";
    ViewData["Description"] = $"All-time {Model.CharacterDisplayName} BB ratings for BlazBlue Centralfiction.";
}

<div class="mainDiv container py-4">
    <h1 class="page-seo-title">All-time @Model.CharacterDisplayName rankings</h1>
    <p class="page-seo-lead">Inactive @Model.CharacterDisplayName players appear here.</p>
    @{
        ViewData["PreviousPageUrl"] = Model.Top.HasPreviousPage
            ? Model.GetPageUrl(Model.Top.PageNumber - 1)
            : null;
        ViewData["NextPageUrl"] = Model.Top.HasNextPage
            ? Model.GetPageUrl(Model.Top.PageNumber + 1)
            : null;
    }
    <partial name="_TopPlayersTable" model="Model.Top" />
    <partial name="_TopPlayersPagination" model="Model.Top" />
</div>
