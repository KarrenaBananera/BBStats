@page "/"
@model BBStats.Pages.Top.IndexModel
@{
    var pageSuffix = Model.Top.PageNumber > 1 ? $" — Page {Model.Top.PageNumber}" : "";
    ViewData["Title"] = "BlazBlue Elo — BlazBlue Centralfiction Player Ratings" + pageSuffix;
    ViewData["Description"] = "Ranked BlazBlue Centralfiction ratings. Check BB player Elo, character leaderboards, and match stats.";
    ViewData["OgTitle"] = "BB Stats";
    ViewData["OgDescription"] = "Ranked Elo and player stats for BlazBlue Centralfiction.";
    ViewData["OgImage"] = "/data/icon/BlazBlue_Clone_Phantasma_Jin_Kisaragi_Icon.png";
}

<div class="mainDiv container py-4">
    <h1 class="page-seo-title">BlazBlue Centralfiction Rankings</h1>
    <p class="page-seo-lead">BlazBlue Elo, player ratings, and ranked stats for BlazBlue Centralfiction.</p>
    <section id="featured-players-section" class="featured-players-section mb-4" hidden>
        <div class="secondLevelDiv">
            <h2 class="featured-players-title">Featured Players</h2>
            <div id="featured-players-list" class="featured-players-list"></div>
        </div>
    </section>

    @{
        ViewData["PreviousPageUrl"] = Model.Top.HasPreviousPage
            ? Model.GetPageUrl(Model.Top.PageNumber - 1)
            : null;
        ViewData["NextPageUrl"] = Model.Top.HasNextPage
            ? Model.GetPageUrl(Model.Top.PageNumber + 1)
            : null;
    }
    <partial name="_TopPlayersTable" model="Model.Top" />
    <partial name="_TopPlayersPagination" model="Model.Top" />
</div>
